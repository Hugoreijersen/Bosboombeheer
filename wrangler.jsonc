// Cloudflare Workers: zet deze map online als statische site (geen eigen server-code).
// Cloudflare bouwt automatisch bij elke push (Workers Builds, gekoppeld aan GitHub).
// Wat niet online hoort (SQL, tests, deze config) staat in .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bosboombeheer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./"
  },
  // Testlink per pull request (npx wrangler preview). Leeg = zelfde instellingen als productie.
  "previews": {}
}
